digraph ER {
 graph [rankdir=LR, fontname="Carlito", fontsize=26, nodesep=0.22, ranksep=0.55, pad=0.2, splines=true];
 node [shape=plain, fontname="Carlito", fontsize=19];
 edge [fontname="Carlito", fontsize=18, color="#44546A", penwidth=1.5, arrowsize=0.9];
 Users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2B5C9A"><TR><TD BGCOLOR="#2B5C9A"><FONT COLOR="white" FACE="Carlito Bold" POINT-SIZE="20"><B>Users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1F7">PK _id: ObjectId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1F7">name, email (unique), passwordHash</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1F7">role: user/admin, status</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1F7">timezone, reminderPrefs</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1F7">aiConsent, aiConsentAt</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1F7">onboardingDone, createdAt</TD></TR></TABLE>>];
 WellnessLogs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F8A70"><TR><TD BGCOLOR="#2F8F83"><FONT COLOR="white" FACE="Carlito Bold" POINT-SIZE="20"><B>WellnessLogs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">PK _id  |  FK userId → Users</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">date, mood, stressLevel</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">sleepHours, waterIntakeMl</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">activityMinutes, energyLevel</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">createdAt</TD></TR></TABLE>>];
 JournalEntries [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F8A70"><TR><TD BGCOLOR="#2F8F83"><FONT COLOR="white" FACE="Carlito Bold" POINT-SIZE="20"><B>JournalEntries</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">PK _id  |  FK userId → Users</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">title, content (private)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">mood, tags, createdAt</TD></TR></TABLE>>];
 Goals [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F8A70"><TR><TD BGCOLOR="#2F8F83"><FONT COLOR="white" FACE="Carlito Bold" POINT-SIZE="20"><B>Goals</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">PK _id  |  FK userId → Users</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">title, type (daily/weekly)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">targetValue, currentValue, unit</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">status, deadline</TD></TR></TABLE>>];
 Conversations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F8A70"><TR><TD BGCOLOR="#2F8F83"><FONT COLOR="white" FACE="Carlito Bold" POINT-SIZE="20"><B>Conversations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">PK _id  |  FK userId → Users</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">title, messages[]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">safetyFlagged, expiresAt</TD></TR></TABLE>>];
 Routines [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F8A70"><TR><TD BGCOLOR="#2F8F83"><FONT COLOR="white" FACE="Carlito Bold" POINT-SIZE="20"><B>Routines</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">PK _id  |  FK userId → Users</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">title, items[]</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">isActive, savedAt</TD></TR></TABLE>>];
 Notifications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F8A70"><TR><TD BGCOLOR="#2F8F83"><FONT COLOR="white" FACE="Carlito Bold" POINT-SIZE="20"><B>Notifications</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">PK _id  |  FK userId → Users</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">FK goalId → Goals (optional)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">type, title, message</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">isRead, scheduledFor</TD></TR></TABLE>>];
 WellnessReports [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F8A70"><TR><TD BGCOLOR="#2F8F83"><FONT COLOR="white" FACE="Carlito Bold" POINT-SIZE="20"><B>WellnessReports</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">PK _id  |  FK userId → Users</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">weekStart, weekEnd</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">metrics, missingDays</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">aiSummary (optional), generatedAt</TD></TR></TABLE>>];
 Resources [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F8A70"><TR><TD BGCOLOR="#2F8F83"><FONT COLOR="white" FACE="Carlito Bold" POINT-SIZE="20"><B>Resources</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">PK _id  |  FK createdBy → Users (admin)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">title, type, category</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">content, breathingPattern</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">isPublished</TD></TR></TABLE>>];
 ContentReports [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F8A70"><TR><TD BGCOLOR="#2F8F83"><FONT COLOR="white" FACE="Carlito Bold" POINT-SIZE="20"><B>ContentReports</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">PK _id  |  FK reporterId → Users</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">FK resourceId → Resources</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6F5F2">reason, status, createdAt</TD></TR></TABLE>>];
 Users -> WellnessLogs [label="1 : N"];
 Users -> JournalEntries [label="1 : N"];
 Users -> Goals [label="1 : N"];
 Users -> Conversations [label="1 : N"];
 Users -> Routines [label="1 : N"];
 Users -> Notifications [label="1 : N"];
 Users -> WellnessReports [label="1 : N"];
 Users -> Resources [label="1 : N\nadmin authors"];
 Users -> ContentReports [label="1 : N\nreporter"];
 Goals -> Notifications [style=dashed, label="0..1 : N"];
 Resources -> ContentReports [label="1 : N"];
}